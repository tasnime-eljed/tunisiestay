<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ---- Initialisation Carte (Leaflet) ----
        const lat = {{ logement.latitude ?? 33.8869 }}; 
        const lng = {{ logement.longitude ?? 9.5375 }};
        const map = L.map('map').setView([lat, lng], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        L.marker([lat, lng]).addTo(map)
            .bindPopup('{{ logement.titre|e('js') }}')
            .openPopup();

        const blockedDates = JSON.parse(document.getElementById('dates-bloquees').textContent || '[]');

        // ---- Calendrier inline disponibilités (lecture seule) ----
        flatpickr('#inline-calendar', {
            inline: true,
            minDate: 'today',
            disable: blockedDates,
            locale: 'fr',
            mode: 'range',
            showMonths: window.innerWidth > 900 ? 2 : 1,
            onReady: function(_, __, fp) {
                fp.calendarContainer.style.width = '100%';
            }
        });

        // ---- Calendrier inline réservation (sélection plage) ----
        const bookingCal = document.getElementById('booking-calendar');
        const hiddenIn   = document.getElementById('hidden-check-in');
        const hiddenOut  = document.getElementById('hidden-check-out');
        const recap      = document.getElementById('booking-recap');

        if (bookingCal) {
            flatpickr('#booking-calendar', {
                inline: true,
                mode: 'range',
                minDate: 'today',
                disable: blockedDates,
                locale: '{{ app.request.locale }}',
                showMonths: 1,
                onReady: function(_, __, fp) {
                    fp.calendarContainer.style.width = '100%';
                },
                onChange: function(selectedDates) {
                    if (selectedDates.length === 2) {
                        const fmt = function(d) {
                            const locale = '{{ app.request.locale }}' === 'ar' ? 'ar-TN' : ('{{ app.request.locale }}' === 'en' ? 'en-GB' : 'fr-FR');
                            return d.toLocaleDateString(locale, {day:'2-digit', month:'short', year:'numeric'});
                        };
                        const ymd = function(d) {
                            return d.toISOString().split('T')[0];
                        };
                        const diff = Math.ceil((selectedDates[1] - selectedDates[0]) / 86400000);

                        hiddenIn.value  = ymd(selectedDates[0]);
                        hiddenOut.value = ymd(selectedDates[1]);

                        document.getElementById('recap-arrivee').textContent = fmt(selectedDates[0]);
                        document.getElementById('recap-depart').textContent  = fmt(selectedDates[1]);
                        document.getElementById('recap-nuits').textContent   = diff;
                        document.getElementById('recap-s').textContent       = diff > 1 ? 's' : '';
                        recap.style.display = 'block';

                        // Recalcul du prix
                        const base  = prix * diff;
                        const comm  = Math.round(base * commission * 100) / 100;
                        const total = base + comm;
                        document.getElementById('calcul-base').textContent       = base.toFixed(2)  + ' ' + devise;
                        document.getElementById('calcul-commission').textContent = comm.toFixed(2)  + ' ' + devise;
                        document.getElementById('calcul-total').textContent      = total.toFixed(2) + ' ' + devise;
                    } else {
                        recap.style.display = 'none';
                        hiddenIn.value  = '';
                        hiddenOut.value = '';
                        document.getElementById('calcul-base').textContent       = '—';
                        document.getElementById('calcul-commission').textContent = '—';
                        document.getElementById('calcul-total').textContent      = '—';
                    }
                }
            });
        }
    });
</script>

{# ===== JS : Étoiles + Favori AJAX ===== #}
<script>
document.addEventListener('DOMContentLoaded', function () {

    // ---- STAR RATING INTERACTIF ----
    const starContainer = document.getElementById('star-rating');
    if (starContainer) {
        const stars = starContainer.querySelectorAll('.star');
        const radios = starContainer.querySelectorAll('input[type=radio]');

        const updateStars = (val) => {
            stars.forEach(function (s) {
                s.style.color = parseInt(s.dataset.value) <= val ? '#F0A500' : '#CBD5E1';
            });
        };

        radios.forEach(function (radio) {
            radio.addEventListener('change', function () {
                updateStars(parseInt(this.value));
            });
        });

        stars.forEach(function (star) {
            star.addEventListener('mouseover', function () {
                updateStars(parseInt(this.dataset.value));
            });

            star.addEventListener('mouseout', function () {
                const checked = starContainer.querySelector('input:checked');
                updateStars(checked ? parseInt(checked.value) : 0);
            });
        });
    }

    // ---- BOUTON FAVORI AJAX ----
    const btnFavori = document.getElementById('btn-favori');
    if (btnFavori) {
        btnFavori.addEventListener('click', function () {
            const logementId = this.dataset.logementId;
            const csrf = this.dataset.csrf;
            const icon = document.getElementById('favori-icon');

            fetch('/favori/toggle/' + logementId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: '_token=' + encodeURIComponent(csrf)
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.status === 'added') {
                    icon.setAttribute('fill', '#F0A500');
                    icon.setAttribute('stroke', '#F0A500');
                    btnFavori.title = '{{ 'logement.retirer_favoris'|trans }}';
                    showToast('❤️ {{ 'logement.ajoute_favoris'|trans }}', '#10B981');
                } else {
                    icon.setAttribute('fill', 'none');
                    icon.setAttribute('stroke', '#94A3B8');
                    btnFavori.title = '{{ 'logement.ajouter_favoris'|trans }}';
                    showToast('{{ 'logement.retire_favoris'|trans }}', '#64748B');
                }
            })
            .catch(function () {
                showToast('Une erreur est survenue', '#EF4444');
            });
        });
    }

    // ---- VALIDATION RÉSERVATION ----
    window.validateBooking = function(e) {
        const checkIn = document.getElementById('hidden-check-in').value;
        const checkOut = document.getElementById('hidden-check-out').value;
        
        if (!checkIn || !checkOut) {
            e.preventDefault();
            showToast('⚠️ {{ 'booking.selection_dates_necessaire'|trans }}', '#EF4444');
            return false;
        }
        return true;
    };

    // ---- VALIDATION AVIS ----
    window.validateReview = function(e) {
        const note = document.querySelector('input[name="note"]:checked');
        const comment = document.querySelector('textarea[name="commentaire"]').value;

        if (!note) {
            e.preventDefault();
            showToast('⚠️ {{ 'logement.selection_note_necessaire'|trans }}', '#EF4444');
            return false;
        }

        if (comment.trim().length < 5) {
            e.preventDefault();
            showToast('⚠️ {{ 'logement.commentaire_trop_court'|trans }}', '#EF4444');
            return false;
        }

        return true;
    };

    // ---- TOAST NOTIFICATION ----
    function showToast(message, color) {
        const existing = document.getElementById('ts-toast');
        if (existing) existing.remove();
        const toast = document.createElement('div');
        toast.id = 'ts-toast';
        toast.textContent = message;
        toast.style.cssText = 'position:fixed;bottom:28px;left:50%;transform:translateX(-50%);background:' + color + ';color:white;padding:12px 28px;border-radius:50px;font-size:14px;font-weight:600;z-index:9999;box-shadow:0 8px 24px rgba(0,0,0,0.18);opacity:1;transition:opacity 0.4s';
        document.body.appendChild(toast);
        setTimeout(function () {
            toast.style.opacity = '0';
            setTimeout(function () { toast.remove(); }, 400);
        }, 3000);
    }

});
</script>

